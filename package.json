{
  "name": "upc-validator",
  "version": "1.0.0",
  "description": "A Real-Time System for Validating and Decoding Product Barcodes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "upc",
    "barcode",
    "validator",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/node": "24.7.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "postcss": "8.5.6"
  },
  "dependencies": {
    "jsbarcode": "^3.11.6",
    "@zxing/library": "^0.20.0",
    "jspdf": "^2.5.1",
    "better-sqlite3": "^9.2.2",
    "path": "0.12.7",
    "next": "15.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.545.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "canvas": "3.2.0",
    "fs": "0.0.1-security"
  },
  "build": {
    "appId": "com.upcvalidator.app",
    "productName": "UPC Validator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
